# .env.example — Running Coaching Project
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees .env al repositorio.

# ─── Google Sheets ───────────────────────────────────────────────────────────
# ID del Google Sheet master (parte de la URL: /d/{SHEET_ID}/edit)
SHEET_ID=

# Ruta al archivo JSON del Service Account de Google.
# Coloca el archivo en secrets/ (esa carpeta está en .gitignore).
GOOGLE_SA_JSON=secrets/google_service_account.json

# ─── Strava ──────────────────────────────────────────────────────────────────
# Credenciales de la app Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ─── Pipeline ────────────────────────────────────────────────────────────────
# Carpeta local donde se almacenan los datos por atleta (carpetas numéricas = cédulas)
DATA_DIR=data/athletes

# Zona horaria para cálculos de fechas
TIMEZONE=America/Bogota

# ─── Supabase (Fase A: dual-write) ───────────────────────────────────────────
# Cuando estén configuradas, POST /athletes/{cedula}/sync también hace push a Supabase.
# Si están vacías, el sistema funciona igual pero sin persistencia externa.
#
# Cómo obtenerlas: Supabase Dashboard → Settings → API
#   SUPABASE_URL    → "Project URL" (ej: https://xxxx.supabase.co)
#   SUPABASE_SERVICE_KEY → "service_role" key (NO la anon key — esta tiene acceso total)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── API interna ─────────────────────────────────────────────────────────────
# Clave para proteger los endpoints (opcional en desarrollo, recomendada en producción)
# Si está vacía, todos los endpoints son públicos.
API_KEY=

# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Dev: dejar vacío → permite cualquier origen (*)
# Prod: poner el dominio real → ej: https://app.tudominio.com
ALLOWED_ORIGINS=

# ─── IA (opcional) ───────────────────────────────────────────────────────────
# API key de Anthropic Claude — necesaria cuando se implemente la integración IA
# Documentación: https://docs.anthropic.com
ANTHROPIC_API_KEY=
