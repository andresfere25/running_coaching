        <mxCell id="acad_valid" value="&lt;b&gt;Validación estadística:&lt;/b&gt; Friedman-Nemenyi (comparación modelos) · Split-conformal prediction (intervalos 80%) · Análisis de potencia Monte Carlo (tamaño de muestra)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=2;fontColor=#5C636E;" vertex="1" parent="1">
