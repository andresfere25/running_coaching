        <mxCell id="md_lane_valid" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BDBDBD;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontColor=#424242;" value="VALIDACIÓN ESTADÍSTICA Y BENCHMARKS (aplicados al Nivel 1, plan idéntico para 2-3)" vertex="1">
          <mxGeometry height="280" width="1420" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="md_v1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;GroupKFold K=10&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Anti-leakage: cada usuario&lt;br&gt;solo en train O test&lt;br&gt;Inyectado a naïveautoml&lt;br&gt;vía PregenSplitter&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="80" y="660" as="geometry" />
        </mxCell>
        <mxCell id="md_v2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;Friedman + Nemenyi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Top-5 modelos (N=356)&lt;br&gt;χ² = 14.36 · p = 0.0062&lt;br&gt;naïveAutoML &gt; MLP (p=0.009)&lt;br&gt;naïveAutoML ≈ Ridge (p=0.66)&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="240" x="320" y="660" as="geometry" />
        </mxCell>
        <mxCell id="md_v3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;Split-conformal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;60/20/20 por usuario&lt;br&gt;n_cal = 5 007 sesiones&lt;br&gt;q = ±62.3 sec/km&lt;br&gt;Cobertura empírica = 0.784&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="580" y="660" as="geometry" />
        </mxCell>
        <mxCell id="md_v4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1976D2;fontSize=11;align=center;verticalAlign=middle;" value="&lt;b&gt;Análisis de potencia&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Monte Carlo (01_analisis_potencia)&lt;br&gt;Umbral mínimo: N ≥ 40 atletas&lt;br&gt;Cohorte efectiva: 48-49-51&lt;br&gt;&lt;b&gt;Umbral superado ✅&lt;/b&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="220" x="820" y="660" as="geometry" />
        </mxCell>
        <mxCell id="md_v5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#C41E3A;fontSize=10;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Ranking final (NB12 v5)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;naïveAutoML  39.76 ✅&lt;br&gt;Ridge        40.16&lt;br&gt;ElasticNet   40.65&lt;br&gt;GradBoost    40.78&lt;br&gt;MLP          40.90&lt;br&gt;Karvonen     43.91 (baseline)&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="1080" y="660" as="geometry" />
        </mxCell>
        <mxCell id="md_artefacts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#00695C;fontSize=10;align=center;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;Artefactos&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;nivel1_prior_FULL_v5.pkl&lt;br&gt;nivel1_naiveautoml_v5.json&lt;br&gt;(api/models/)&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="100" x="1340" y="660" as="geometry" />
        </mxCell>
        <mxCell id="md_baseline_note" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#5C636E;" value="&lt;b&gt;Mejora vs. Karvonen baseline:&lt;/b&gt; −4.15 sec/km (−9.4%)  ·  &lt;b&gt;Mejora vs. naïve baseline:&lt;/b&gt; −4.27 sec/km (−9.7%)" vertex="1">
          <mxGeometry height="20" width="1000" x="80" y="830" as="geometry" />
        </mxCell>
        <mxCell id="md_leyenda" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=2;fontColor=#5C636E;" value="✅ Los 4 niveles desplegados en producción Railway · Riegel calibrado = módulo auxiliar para tiempos por distancia" vertex="1">
          <mxGeometry height="20" width="1420" x="40" y="930" as="geometry" />
        </mxCell>
              <mxCell id="md_n4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontSize=11;align=center;verticalAlign=middle;strokeWidth=2;" value="&lt;b&gt;Nivel 4 ✅&lt;/b&gt; · Corrección personal walk-forward&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;ŷ_N4(t) = ŷ_N3(t) + sesgo_K&lt;br&gt;K=15 sesiones (~4-5 sem)&lt;br&gt;51 atletas · 8 718 sesiones&lt;br&gt;&lt;br&gt;1 parámetro por atleta&lt;br&gt;Sin reentrenamiento&lt;br&gt;Wilcoxon signed-rank p&lt;0.001&lt;br&gt;&lt;br&gt;&lt;b&gt;MAE 31.84 sec/km&lt;/b&gt;&lt;br&gt;-18.3% vs N3 · -49.0% acumulado&lt;br&gt;&lt;br&gt;Activación: ≥5 sesiones HR&lt;/span&gt;" vertex="1">
          <mxGeometry height="240" width="280" x="1180" y="490" as="geometry" />
        </mxCell>
