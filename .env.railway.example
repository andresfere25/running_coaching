# Variables para Railway — pegar en Railway Dashboard → Variables
# NO commitear con valores reales. Este archivo es solo documentación.
#
# Cómo usarlo:
#   Railway Dashboard → tu proyecto → Variables → Raw Editor
#   Pegar y reemplazar los valores entre < >

# ── OBLIGATORIAS para que el backend arranque y sirva datos ──────────────────

SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Orígenes CORS permitidos — el dominio del portal (sin barra final)
ALLOWED_ORIGINS=https://app.arathleteslab.com

# ── OBLIGATORIAS para sync completo (pipeline + Strava + Google Sheets) ──────

# Base64 del archivo secrets/google_service_account.json (una sola línea, sin espacios)
# Generar en PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("secrets\google_service_account.json"))
GOOGLE_SA_JSON_B64=eyJ0eXBlIjoic2Vydmljz...

# Ruta donde el Dockerfile escribe el JSON decodificado (no cambiar)
GOOGLE_SA_JSON=secrets/google_service_account.json

# ID del Google Sheet master (URL: /d/{SHEET_ID}/edit)
SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# App OAuth de Strava (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=180293
STRAVA_CLIENT_SECRET=<tu-strava-client-secret>

# ── RECOMENDADAS para producción ──────────────────────────────────────────────

# Protege todos los endpoints con X-API-Key header (dejar vacío = endpoints públicos)
API_KEY=<genera-una-clave-aleatoria-segura>

# Zona horaria para cálculos de fechas
TIMEZONE=America/Bogota

# ── NOTA SOBRE CRON ───────────────────────────────────────────────────────────
# El sync semanal NO va en railway.json — se configura en Railway Dashboard:
#   New Service → Cron Job
#   Schedule: 0 11 * * 1   (lunes 11:00 UTC = 6am Bogotá)
#   Command:  curl -s -X POST https://<tu-url>.up.railway.app/athletes/1070982737/sync -H "X-API-Key: <API_KEY>"
